            border-radius: var(--border-radius);
            background-color: white;
            transition: var(--transition);
            border: 1px solid rgba(0, 0, 0, 0.03);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.03);
            text-align: center;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
