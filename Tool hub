        /* Features Section */
        .features-section {
            background-color: white;
            border-radius: var(--border-radius-lg);
            padding: 50px 35px;
            box-shadow: var(--box-shadow);
            margin-top: 30px;
            position: relative;
            overflow: hidden;
        }
        
        .features-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: var(--gradient-primary);
